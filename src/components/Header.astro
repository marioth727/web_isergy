---
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink } from '../config/site';

const nav = [
  { label: 'Beneficios', href: '/#beneficios' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Cómo funciona', href: '/#proceso' },
  { label: 'Calculadora', href: '/#calculadora' },
  { label: 'Cobertura', href: '/#cobertura' },
  { label: 'Preguntas', href: '/#faq' },
];
---
<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label="Isergy — inicio">
      <Logo />
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="btn header__cta" href={whatsappLink()} target="_blank" rel="noopener">
      <WhatsAppIcon /> Cotizar
    </a>

    <button class="header__burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="header__mobile" data-mobile-menu hidden>
    <nav aria-label="Navegación móvil">
      {nav.map((item) => <a href={item.href} data-mobile-link>{item.label}</a>)}
    </nav>
    <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
      <WhatsAppIcon /> Cotizar por WhatsApp
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background var(--dur) ease, box-shadow var(--dur) ease,
                backdrop-filter var(--dur) ease;
  }
  .header[data-scrolled] {
    background: color-mix(in oklch, var(--paper) 82%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line), var(--shadow-sm);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: 4.75rem;
  }
  .header__brand { margin-right: auto; }

  .header__nav {
    display: none;
    gap: clamp(1rem, 2vw, 2rem);
    font-weight: 600;
    font-size: var(--step--1);
  }
  .header__nav a {
    color: var(--ink-soft);
    position: relative;
    padding-block: 0.25rem;
    transition: color var(--dur-fast) ease;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    width: 100%; height: 2px;
    background: var(--brand-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out-quart);
  }
  .header__nav a:hover { color: var(--ink); }
  .header__nav a:hover::after { transform: scaleX(1); }

  .header__cta { display: none; padding: 0.6em 1.15em; font-size: var(--step--1); }

  /* Burger */
  .header__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem; height: 2.75rem;
    padding: 0 0.6rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }
  .header__burger span {
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out-quart), opacity var(--dur-fast) ease;
  }
  .header__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menú móvil */
  .header__mobile {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg) var(--gutter) var(--space-xl);
    background: color-mix(in oklch, var(--paper) 95%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow-lg);
    border-top: 1px solid var(--line);
  }
  .header__mobile[hidden] { display: none; }
  .header__mobile nav { display: grid; gap: var(--space-xs); }
  .header__mobile nav a {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--ink);
    padding-block: 0.35rem;
  }

  @media (min-width: 60rem) {
    .header__nav { display: flex; }
    .header__cta { display: inline-flex; }
    .header__burger, .header__mobile { display: none; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement;
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement;

  // Sombra + fondo al hacer scroll
  const onScroll = () => {
    if (window.scrollY > 12) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil
  const closeMenu = () => {
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Abrir menú');
    menu.hidden = true;
  };
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    if (open) { closeMenu(); }
    else {
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Cerrar menú');
      menu.hidden = false;
    }
  });
  menu?.querySelectorAll('[data-mobile-link]').forEach((link) =>
    link.addEventListener('click', closeMenu),
  );
</script>
