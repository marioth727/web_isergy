---
const steps = [
  { n: '1', title: 'Diagnóstico', desc: 'Analizamos tu factura y tu consumo para entender cuánto puedes ahorrar. Sin costo.' },
  { n: '2', title: 'Diseño a medida', desc: 'Dimensionamos el sistema ideal para tu techo y presupuesto, con propuesta clara.' },
  { n: '3', title: 'Instalación', desc: 'Nuestro equipo certificado instala y conecta todo, normalmente en 1 a 3 días.' },
  { n: '4', title: 'Ahorro y soporte', desc: 'Enciendes tu sistema y empiezas a ahorrar. Te acompañamos con mantenimiento.' },
];
---
<section class="section process" id="proceso">
  <div class="container">
    <header class="process__head">
      <p class="eyebrow">Cómo funciona</p>
      <h2 class="process__title">Tu cambio al sol en 4 pasos</h2>
    </header>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <div class="step__marker"><span>{s.n}</span></div>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__head { max-width: 40rem; margin-bottom: var(--space-2xl); }
  .process__title { font-size: var(--step-4); margin-top: var(--space-sm); }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
    counter-reset: step;
  }
  .step { display: grid; gap: var(--space-2xs); position: relative; }
  .step__marker {
    display: grid;
    place-items: center;
    width: 3.25rem; height: 3.25rem;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--brand-orange);
    color: var(--brand-orange);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    margin-bottom: var(--space-2xs);
    z-index: 1;
  }
  .step h3 { font-size: var(--step-1); }
  .step p { color: var(--ink-soft); max-width: 34ch; }

  @media (min-width: 52rem) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
    /* línea conectora */
    .step::before {
      content: '';
      position: absolute;
      top: 1.6rem; left: 3.25rem; right: calc(-1 * var(--space-lg));
      height: 2px;
      background: repeating-linear-gradient(90deg, var(--brand-orange-soft) 0 8px, transparent 8px 16px);
    }
    .step:last-child::before { display: none; }
  }
</style>
