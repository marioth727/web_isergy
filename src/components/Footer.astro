---
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { site, whatsappLink } from '../config/site';

const year = new Date().getFullYear();
const nav = [
  { label: 'Beneficios', href: '/#beneficios' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Cómo funciona', href: '/#proceso' },
  { label: 'Calculadora', href: '/#calculadora' },
  { label: 'Cobertura', href: '/#cobertura' },
  { label: 'Preguntas', href: '/#faq' },
];
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo variant="footer" />
      <p>Energía solar fotovoltaica para hogares y negocios en {site.city} y la costa Caribe.</p>
      <a class="btn" href={whatsappLink()} target="_blank" rel="noopener">
        <WhatsAppIcon /> Cotiza gratis
      </a>
    </div>

    <nav class="footer__nav" aria-label="Enlaces del pie">
      <h3>Legal</h3>
      <ul>
        <li><a href="/politica-privacidad/">Política de Privacidad</a></li>
        <li><a href="/terminos/">Términos y Condiciones</a></li>
      </ul>
    </nav>

    <div class="footer__contact">
      <h3>Contacto</h3>
      <address>
        <a href={whatsappLink()} target="_blank" rel="noopener">{site.whatsappDisplay}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>{site.address}</span>
      </address>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} {site.legalName}. Todos los derechos reservados.</span>
    <span>Energía solar en {site.city}, {site.country}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-surface-deep);
    color: oklch(0.82 0.01 80);
    padding-top: var(--space-3xl);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }
  .footer h3 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: oklch(0.65 0.02 80);
    margin-bottom: var(--space-sm);
  }
  .footer__brand { display: grid; gap: var(--space-md); max-width: 26rem; }
  .footer__brand p { color: oklch(0.78 0.01 80); }
  .footer__brand .btn { width: fit-content; }

  .footer__nav ul { list-style: none; padding: 0; display: grid; gap: var(--space-2xs); }
  .footer a { color: oklch(0.82 0.01 80); transition: color var(--dur-fast) ease; }
  .footer a:hover { color: var(--brand-orange); }

  .footer__contact address { font-style: normal; display: grid; gap: var(--space-2xs); }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    border-top: 1px solid oklch(1 0 0 / 0.08);
    font-size: var(--step--1);
    color: oklch(0.6 0.01 80);
  }

  @media (min-width: 52rem) {
    .footer__inner { grid-template-columns: 2fr 1fr 1.3fr; gap: var(--space-2xl); }
  }
</style>
